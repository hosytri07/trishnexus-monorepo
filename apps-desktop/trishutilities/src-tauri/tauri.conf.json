{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrishUtilities",
  "version": "1.0.0",
  "identifier": "vn.trishteam.utilities",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1442",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrishUtilities — Tiện ích hệ thống",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$APPDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "_comment": "Phase 44 - Auto-update placeholder. Set pubkey + endpoint khi release that.",
      "active": false,
      "endpoints": [
        "https://trishteam.io.vn/api/updates/{{target}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": ""
    }
  }
}