{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrishWork",
  "version": "1.0.0",
  "identifier": "vn.trishteam.work",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrishWork — Kỹ sư · Thư viện · ISO",
        "width": 1700,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 740,
        "resizable": true,
        "center": true
      },
      {
        "label": "sticky",
        "title": "Ghi nhanh — TrishWork",
        "url": "index.html?sticky=1",
        "width": 320,
        "height": 380,
        "minWidth": 240,
        "minHeight": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$APPDATA/**",
          "$TEMP/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "_comment": "Phase 44 - Auto-update placeholder. Set pubkey + endpoint khi release that.",
      "active": false,
      "endpoints": [
        "https://trishteam.io.vn/api/updates/{{target}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": ""
    }
  }
}