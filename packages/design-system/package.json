{
  "name": "@trishteam/design-system",
  "version": "1.1.0",
  "private": true,
  "description": "TrishTEAM design system - Plus Jakarta Sans + 4 app accents (Work/Utilities/Finance/Admin) + AppShell layout + utility CSS. Phase 24.3 unify + Phase 44.1 multi-app accents.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./fonts": {
      "types": "./src/fonts.ts",
      "import": "./src/fonts.ts"
    },
    "./AppShell": {
      "types": "./src/AppShell.tsx",
      "import": "./src/AppShell.tsx"
    },
    "./AppLogo": {
      "types": "./src/AppLogo.tsx",
      "import": "./src/AppLogo.tsx"
    }
  },
  "files": ["src"],
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "firebase": ">=10.0.0"
  }
}
